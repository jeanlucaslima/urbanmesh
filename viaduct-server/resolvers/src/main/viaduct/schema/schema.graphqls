extend type Query {
  greeting: String @resolver
  customer(id: ID!): Customer @resolver
}

type Customer {
  id: ID!
  name: String
  status: String
  riskLevel: String

  billing: BillingAccount @resolver
  support: SupportSummary @resolver
}

type BillingAccount {
  balance: Float
  overdueInvoices: Int
  paymentRisk: String
}

type SupportSummary {
  openTickets: Int
  latestIssue: String
  escalationStatus: String
}
