extend type Query {
  greeting: String @resolver
  block(id: ID!, actorRole: ActorRole!): CityBlock @resolver
}

enum ActorRole {
  PUBLIC_AI_ASSISTANT
  CIVIC_OPERATOR
  PERMIT_ANALYST
  CITY_ADMIN
}

type CityBlock {
  id: ID!
  name: String
  neighborhood: String
  planningStatus: String
  planningRisk: String

  zoning: ZoningInfo @resolver
  permits: PermitSummary @resolver
  civic: CivicCaseSummary @resolver
  transit: TransitSummary @resolver
  census: CensusProfile @resolver
}

type ZoningInfo {
  district: String
  allowedUses: String
  heightLimit: String
  specialUseDistrict: String
}

type PermitSummary {
  activePermits: Int
  recentPermits: Int
  estimatedProjectValue: Float
  complianceRisk: String
}

type CivicCaseSummary {
  openCases: Int
  latestIssue: String
  escalationStatus: String
  source: String
  recentCases: [CivicCase!]
}

type CivicCase {
  caseId: String
  category: String
  type: String
  status: String
  openedAt: String
  address: String
}

type TransitSummary {
  nearbyStops: Int
  accessScore: Int
  ridershipTrend: String
}

type CensusProfile {
  population: Int
  medianIncome: Int
  housingDensity: String
}
