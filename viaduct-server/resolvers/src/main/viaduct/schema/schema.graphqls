extend type Query {
  greeting: String @resolver
  customer(id: ID!, actorRole: ActorRole!): Customer @resolver
}

enum ActorRole {
  AI_ASSISTANT
  SUPPORT_AGENT
  FINANCE_AGENT
  ADMIN
}

type Customer {
  id: ID!
  name: String
  status: String
  riskLevel: String

  billing: BillingAccount @resolver
  support: SupportSummary @resolver
  usage: UsageSummary @resolver
}

type BillingAccount {
  balance: Float
  overdueInvoices: Int
  paymentRisk: String
}

type SupportSummary {
  openTickets: Int
  latestIssue: String
  escalationStatus: String
}

type UsageSummary {
  activeUsers: Int
  monthlyEvents: Int
  usageTrend: String
}
