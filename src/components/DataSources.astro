---
const sources = [
  { name: 'Building Permits', count: '150K', geo: 'Point', provider: 'DataSF' },
  { name: 'Zoning Districts', count: '130', geo: 'MultiPolygon', provider: 'DataSF' },
  { name: 'Land Use', count: '200K', geo: 'Polygon', provider: 'DataSF' },
  { name: 'Muni Stops', count: '3,500', geo: 'Point', provider: 'DataSF' },
  { name: 'Muni Routes', count: '150', geo: 'MultiLineString', provider: 'DataSF' },
  { name: 'GTFS Schedule', count: '1.5M', geo: 'FK', provider: 'SFMTA' },
  { name: '311 Cases', count: '1.5M', geo: 'Point', provider: 'DataSF' },
  { name: 'Census ACS', count: '200', geo: 'Demographics', provider: 'Census' },
  { name: 'Census TIGER', count: '200', geo: 'MultiPolygon', provider: 'Census' },
  { name: 'Street Trees', count: '190K', geo: 'Point', provider: 'DataSF' },
  { name: 'Green Spaces', count: 'Varies', geo: 'Polygon', provider: 'OSM' },
  { name: 'Parcels', count: '200K', geo: 'Polygon', provider: 'DataSF' },
];
---

<section id="data-sources">
  <div class="container">
    <span class="section-label">Data Layer</span>
    <h2 class="section-title">Twelve Sources. One Schema.</h2>
    <p class="section-subtitle">
      All data seeded offline — no external API calls at query time. Every record
      time-windowed, geocoded, and enum-normalized.
    </p>

    <div class="source-grid">
      {sources.map((s) => (
        <div class="source-card">
          <div class="source-header">
            <span class="source-name">{s.name}</span>
            <span class="source-provider">{s.provider}</span>
          </div>
          <div class="source-meta">
            <span class="source-count">{s.count}</span>
            <span class="source-geo mono">{s.geo}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .source-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 48px;
  }

  .source-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    transition: border-color 0.2s, background 0.2s;
  }

  .source-card:hover {
    border-color: var(--accent-dim);
    background: var(--surface-hover);
  }

  .source-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .source-name {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .source-provider {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-muted);
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 3px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .source-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .source-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .source-geo {
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 1024px) {
    .source-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .source-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .source-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
