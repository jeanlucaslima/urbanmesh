---
const domains = [
  {
    name: 'Land',
    icon: 'land',
    module: ':parcels',
    sources: ['Parcels', 'Zoning', 'Land Use'],
    rows: '400K+',
  },
  {
    name: 'Transit',
    icon: 'transit',
    module: ':transit',
    sources: ['Stops', 'Routes', 'Schedules'],
    rows: '1.5M+',
  },
  {
    name: 'Civic',
    icon: 'civic',
    module: ':civic',
    sources: ['311 Cases', 'Permits'],
    rows: '1.6M+',
  },
  {
    name: 'Environment',
    icon: 'env',
    module: ':environment',
    sources: ['Trees', 'Green Spaces'],
    rows: '190K+',
  },
  {
    name: 'Census',
    icon: 'census',
    module: ':census',
    sources: ['Demographics', 'Boundaries'],
    rows: '400+',
  },
];
---

<section id="data-sources">
  <div class="container">
    <span class="section-label">Data Layer</span>
    <h2 class="section-title">Five domains. One schema.</h2>
    <p class="section-subtitle">
      Each domain defines its part of the system.
    </p>
    <p class="system-parts mono">
      entities · relationships · boundaries
    </p>

    <div class="domain-grid">
      {domains.map((d) => (
        <div class="domain-card">
          <div class="domain-head">
            <span class="domain-annotation mono">[{d.module}]</span>
            <div class={`domain-icon icon-${d.icon}`} aria-hidden="true">
              {d.icon === 'land' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 20h18M5 20V8l7-4 7 4v12M9 20v-6h6v6" />
                </svg>
              )}
              {d.icon === 'transit' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="3" width="14" height="14" rx="2" />
                  <path d="M5 10h14M8 21l2-4M14 17l2 4M9 14h.01M15 14h.01" />
                </svg>
              )}
              {d.icon === 'civic' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6M15 21v-6" />
                </svg>
              )}
              {d.icon === 'env' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22V12M12 12c-4 0-6-3-6-6 3 0 6 2 6 6zM12 12c4 0 6-3 6-6-3 0-6 2-6 6z" />
                </svg>
              )}
              {d.icon === 'census' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="8" r="3" />
                  <circle cx="17" cy="10" r="2.5" />
                  <path d="M3 20c0-3 3-5 6-5s6 2 6 5M14 20c0-2 2-4 4.5-4" />
                </svg>
              )}
            </div>
            <span class="domain-name">{d.name}</span>
          </div>
          <ul class="domain-sources">
            {d.sources.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
          <div class="domain-rows mono">{d.rows} rows</div>
        </div>
      ))}
    </div>

    <div class="footer-line mono">
      12 sources · 3.5M+ records · PostGIS-backed
    </div>

    <p class="relationships-line">
      Relationships are defined once.<br />
      Clients do not rebuild them.
    </p>

    <div class="composition">
      <span class="composition-annotation mono">[composed at runtime]</span>

      <div class="comp-diagram">
        <div class="comp-chips">
          {domains.map((d) => (
            <span class="comp-chip">{d.name}</span>
          ))}
        </div>

        <svg class="comp-funnel" viewBox="0 0 500 80" preserveAspectRatio="none" aria-hidden="true">
          <line x1="50" y1="0" x2="250" y2="80" />
          <line x1="150" y1="0" x2="250" y2="80" />
          <line x1="250" y1="0" x2="250" y2="80" />
          <line x1="350" y1="0" x2="250" y2="80" />
          <line x1="450" y1="0" x2="250" y2="80" />
        </svg>

        <div class="comp-target-pill">
          <span class="comp-target-name">One Graph</span>
          <span class="comp-target-tool mono">Viaduct</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .domain-card {
    background: transparent;
    border: none;
    border-top: 1px solid var(--border);
    border-radius: 0;
    padding: 22px 0 22px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.2s;
  }

  .domain-card:hover {
    border-top-color: var(--accent-dim);
  }

  .domain-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    row-gap: 2px;
    align-items: center;
  }

  .domain-annotation {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.62rem;
    color: var(--secondary);
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  .domain-head .domain-icon {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .domain-head .domain-name {
    grid-column: 2;
    grid-row: 2;
  }

  .domain-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-dim);
    color: var(--accent);
    flex-shrink: 0;
  }

  .domain-icon svg {
    width: 20px;
    height: 20px;
    display: block;
    flex-shrink: 0;
  }

  .icon-transit,
  .icon-census {
    background: var(--secondary-dim);
    color: var(--secondary);
  }

  .domain-name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .domain-sources {
    list-style: none;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0;
    margin: 0;
  }

  .domain-sources li {
    list-style: none;
  }

  .domain-sources li {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .domain-rows {
    font-size: 0.7rem;
    color: var(--text-muted);
    opacity: 0.7;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    margin-top: auto;
    letter-spacing: 0.02em;
  }

  .footer-line {
    margin-top: 32px;
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .system-parts {
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .relationships-line {
    margin-top: 24px;
    text-align: center;
    font-size: 1rem;
    color: var(--text);
    font-weight: 500;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .composition {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .composition-annotation {
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.12em;
    opacity: 0.8;
    text-transform: lowercase;
  }

  .comp-diagram {
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .comp-chips {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .comp-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
    padding: 6px 4px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    text-align: center;
    justify-self: stretch;
  }

  .comp-funnel {
    width: 100%;
    height: 80px;
    display: block;
    stroke: rgba(232, 197, 71, 0.45);
    stroke-width: 1;
    fill: none;
    overflow: visible;
  }

  .comp-target-pill {
    align-self: center;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(232, 197, 71, 0.3);
    padding: 10px 18px;
    border-radius: 6px;
  }

  .comp-target-name {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .comp-target-tool {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .comp-target-tool::before {
    content: '·';
    margin-right: 8px;
    opacity: 0.6;
  }

  @media (max-width: 520px) {
    .comp-chips {
      gap: 4px;
    }

    .comp-chip {
      font-size: 0.62rem;
      padding: 5px 2px;
    }

    .comp-funnel {
      height: 56px;
    }
  }

  @media (max-width: 900px) {
    .domain-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .domain-grid {
      grid-template-columns: 1fr;
    }

    .composition-funnel {
      display: none;
    }

    .composition-pill {
      margin-top: 12px;
    }
  }
</style>
