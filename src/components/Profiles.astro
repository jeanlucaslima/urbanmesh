---
const featured = [
  {
    name: 'Urban Planner',
    slug: 'urban-planner',
    focus: 'Zoning compliance, permit history, land-use trends',
    fields: ['zoningCompliance', 'permitHistory', 'landUseTrends'],
  },
  {
    name: 'Resident',
    slug: 'resident',
    focus: 'Nearby trees, transit options, walkability, open 311 cases',
    fields: ['walkabilityScore', 'nearbyTrees', 'open311Cases'],
  },
  {
    name: 'Developer',
    slug: 'real-estate-developer',
    focus: 'Permit timelines, home values, disruption risk',
    fields: ['permitDurationDays', 'medianHomeValue', 'disruptionRisk'],
  },
];

const more = [
  'Transit Planner',
  'Small Business Owner',
  'Environmental Advocate',
  'Data Journalist',
  'Accessibility Advocate',
];
---

<section id="profiles">
  <div class="container">
    <span class="section-label">Profiles</span>
    <h2 class="section-title">Same query. Different output.</h2>
    <p class="section-subtitle">
      The <code class="inline-code">X-UrbanMesh-Profile</code> header controls what resolves.
    </p>
    <p class="profiles-lede">
      The query stays the same.<br />
      The response changes.
    </p>
    <p class="profiles-tail mono">
      No new endpoints. No versioning.
    </p>

    <div class="tree">
      <div class="tree-root mono">query &#123; parcel &#123; insights &#125; &#125;</div>

      <svg class="tree-lines" viewBox="0 0 600 70" preserveAspectRatio="none" aria-hidden="true">
        <line x1="300" y1="0" x2="300" y2="28" />
        <line x1="100" y1="28" x2="500" y2="28" />
        <line x1="100" y1="28" x2="100" y2="70" />
        <line x1="300" y1="28" x2="300" y2="70" />
        <line x1="500" y1="28" x2="500" y2="70" />
      </svg>

      <div class="tree-leaves">
        <div class="tree-leaf">
          <span class="leaf-name">Planner</span>
          <span class="leaf-field mono">zoningCompliance</span>
        </div>
        <div class="tree-leaf">
          <span class="leaf-name">Resident</span>
          <span class="leaf-field mono">walkabilityScore</span>
        </div>
        <div class="tree-leaf">
          <span class="leaf-name">Developer</span>
          <span class="leaf-field mono">disruptionRisk</span>
        </div>
      </div>
    </div>

    <div class="profile-grid">
      {featured.map((p) => (
        <div class="profile-card">
          <div class="profile-header-row">
            <span class="profile-name">{p.name}</span>
          </div>
          <p class="profile-focus">{p.focus}</p>
          <div class="profile-fields">
            {p.fields.map((f) => (
              <span class="field-tag mono">{f}</span>
            ))}
          </div>
          <div class="profile-slug mono">
            <span class="slug-key">Profile:</span> {p.slug}
          </div>
        </div>
      ))}
    </div>

    <div class="more-row">
      <span class="more-label mono">+5 more profiles</span>
      {more.map((n) => (
        <span class="more-chip">{n}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .profiles-lede {
    margin-top: 16px;
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.6;
    font-weight: 500;
  }

  .profiles-tail {
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .inline-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .tree {
    margin: 56px auto 0;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .tree-root {
    align-self: center;
    background: var(--accent-dim);
    border: 1px solid rgba(232, 197, 71, 0.25);
    color: var(--accent);
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .tree-lines {
    width: 100%;
    height: 52px;
    display: block;
    stroke: rgba(232, 197, 71, 0.35);
    stroke-width: 1;
    fill: none;
    overflow: visible;
  }

  .tree-leaves {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .tree-leaf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-top: 4px;
  }

  .leaf-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .leaf-field {
    font-size: 0.75rem;
    color: var(--secondary);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 56px;
  }

  .profile-card {
    background: transparent;
    border: none;
    border-top: 1px solid var(--border);
    border-radius: 0;
    padding: 22px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .profile-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .profile-name {
    font-weight: 600;
    font-size: 1rem;
  }

  .profile-focus {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .profile-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .field-tag {
    font-size: 0.68rem;
    color: var(--secondary);
    background: var(--secondary-dim);
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.01em;
  }

  .profile-slug {
    font-size: 0.7rem;
    color: var(--text-muted);
    padding-top: 8px;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .slug-key {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .more-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 14px 18px;
    border: 1px dashed var(--border);
    border-radius: 8px;
  }

  .more-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 4px;
  }

  .more-chip {
    font-size: 0.78rem;
    color: var(--text-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  @media (max-width: 1024px) {
    .profile-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .tree-lines {
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
