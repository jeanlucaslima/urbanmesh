---
const questions = [
  { text: 'A permit references a parcel.', q: 'Who owns that join?' },
  { text: 'A field needs to change.', q: 'Who signs off?' },
  { text: 'A query slows down in production.', q: 'Who gets paged?' },
];
---

<section id="tension">
  <div class="tension-container">
    <header class="tension-header">
      <span class="tension-marker mono">//  where it breaks</span>
      <h2 class="tension-headline">
        The second year of a<br />shared graph.
      </h2>
      <p class="tension-lede">
        Year one is easy. The schema is small.<br />
        By year two the system grows. More types. More teams.
      </p>
      <p class="tension-lede tension-lede-follow">
        The questions change.
      </p>
    </header>

    <div class="tension-compare" aria-hidden="true">
      <div class="compare-col year-one">
        <span class="compare-year mono">year 01</span>
        <div class="compare-body">
          <p class="compare-state">The schema is small.</p>
          <p class="compare-meta">Few types. Few teams.</p>
        </div>
      </div>

      <div class="compare-arrow" aria-hidden="true">
        <span class="arrow-line"></span>
        <span class="arrow-label mono">scale</span>
      </div>

      <div class="compare-col year-two">
        <span class="compare-year mono">year 02</span>
        <div class="compare-body">
          <p class="compare-state accent">The system grows.</p>
          <p class="compare-meta">More types. More teams.</p>
        </div>
      </div>
    </div>

    <div class="tension-evidence">
      <ul class="tension-questions">
        {questions.map((q) => (
          <li>
            <span class="q-setup">{q.text}</span>
            <span class="q-arrow mono" aria-hidden="true">→</span>
            <span class="q-ask">{q.q}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="tension-observations">
      <p>
        These are coordination problems.<br />
        The schema just makes them visible.
      </p>
      <p>
        One team usually takes it on.<br />
        The graph turns into a bottleneck.
      </p>
    </div>

    <aside class="tension-landing">
      <span class="landing-arrow mono" aria-hidden="true">→</span>
      <div class="landing-body">
        <p class="landing-primary">
          Viaduct pushes that boundary back into the modules.
        </p>
        <p class="landing-secondary">
          Ownership stays with the teams that own the code.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  #tension {
    padding: 140px 0;
    background:
      radial-gradient(circle at 12% 24%, rgba(74, 158, 191, 0.06), transparent 55%),
      radial-gradient(circle at 92% 82%, rgba(232, 197, 71, 0.05), transparent 50%);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .tension-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .tension-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 640px;
  }

  .tension-marker,
  .evidence-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .tension-headline {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.08;
    color: var(--text);
  }

  .tension-lede {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .tension-lede-follow {
    color: var(--text);
    font-weight: 500;
    margin-top: 4px;
  }

  /* year 1 vs year 2 */
  .tension-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: stretch;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 32px 0;
  }

  .compare-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 4px 0;
  }

  .year-two {
    text-align: right;
    align-items: flex-end;
  }

  .compare-year {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .compare-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .year-two .compare-body {
    align-items: flex-end;
  }

  .compare-state {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
    line-height: 1.3;
  }

  .compare-state.accent {
    color: var(--accent);
  }

  .compare-meta {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .compare-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 80px;
  }

  .arrow-line {
    width: 80px;
    height: 1px;
    background: linear-gradient(to right, var(--secondary), var(--accent));
    position: relative;
  }

  .arrow-line::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  .arrow-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* evidence */
  .tension-evidence {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tension-questions {
    list-style: none;
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tension-questions li {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto 280px;
    gap: 20px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .tension-questions li:first-child {
    border-top: 1px solid var(--border);
  }

  .q-setup {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.4;
  }

  .q-arrow {
    font-size: 0.95rem;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .q-ask {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    color: var(--accent);
    line-height: 1.4;
  }

  /* observations */
  .tension-observations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 8px 0;
  }

  .tension-observations p {
    font-size: 1.02rem;
    color: var(--text);
    line-height: 1.6;
  }

  /* landing */
  .tension-landing {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
    padding: 32px 0 0 0;
    border-top: 2px solid var(--accent);
  }

  .landing-arrow {
    font-size: 1.6rem;
    color: var(--accent);
    font-weight: 400;
    line-height: 1;
    padding-top: 4px;
  }

  .landing-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .landing-primary {
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .landing-secondary {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    #tension {
      padding: 96px 0;
    }

    .tension-container {
      gap: 56px;
      padding: 0 20px;
    }

    .tension-compare {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 24px 0;
    }

    .year-two {
      text-align: left;
      align-items: flex-start;
    }

    .year-two .compare-body {
      align-items: flex-start;
    }

    .compare-arrow {
      flex-direction: row;
      gap: 12px;
    }

    .arrow-line {
      width: 48px;
    }

    .tension-questions li {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }

    .q-arrow {
      display: none;
    }

    .tension-observations {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
