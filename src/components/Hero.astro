---
---

<section class="hero">
  <div class="hero-bg">
    <svg class="topo-lines" viewBox="0 0 1200 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <g stroke="#4A9EBF" fill="none" stroke-width="0.5" opacity="0.06">
        <path d="M0 450 Q300 380 600 420 Q900 460 1200 400" />
        <path d="M0 400 Q300 330 600 370 Q900 410 1200 350" />
        <path d="M0 350 Q300 280 600 320 Q900 360 1200 300" />
        <path d="M0 300 Q300 230 600 270 Q900 310 1200 250" />
        <path d="M0 250 Q300 180 600 220 Q900 260 1200 200" />
        <path d="M0 200 Q300 130 600 170 Q900 210 1200 150" />
        <path d="M0 150 Q300 80 600 120 Q900 160 1200 100" />
        <path d="M0 100 Q300 50 600 80 Q900 110 1200 60" />
      </g>
      <g stroke="#E8C547" fill="none" stroke-width="0.4" opacity="0.04">
        <path d="M0 475 Q200 440 500 460 Q800 480 1200 430" />
        <path d="M0 325 Q200 290 500 310 Q800 330 1200 280" />
        <path d="M0 175 Q200 140 500 160 Q800 180 1200 130" />
      </g>
    </svg>
  </div>

  <div class="container hero-content">
    <div class="hero-badges">
      <span class="hero-badge mono">Open Source</span>
      <a class="hero-badge mono" href="https://graphql.org/conf/2026/schedule/50d245b496fbe7e54087e218e9b4b60d/?name=Turning%20San%20Francisco%20Into%20a%20GraphQL%20Server%20-%20Jean%20Lucas%20Lima,%20ConfrariaTech" target="_blank" rel="noopener">GraphQL Conf 2026</a>
    </div>

    <div class="hero-split">
      <div class="hero-left">
        <h1>
          One Graph.<br />
          Any City.<br />
          <span class="accent">Every Data Source.</span>
        </h1>

        <p class="hero-sub">
          A <a href="https://viaduct.dev/" target="_blank" rel="noopener">Viaduct</a>-powered GraphQL graph over a whole city.<br />
          One endpoint for maps, dashboards, and AI.
        </p>
      </div>

      <aside class="hero-right">
        <span class="hero-right-label mono">// what this does</span>
        <p class="hero-grounding">
          Answer complex questions about a city with a single query.
        </p>
        <p class="hero-tail">
          Built from independently owned domains.<br />
          Composed at runtime.
        </p>

        <div class="hero-stats">
          <div class="stat"><span class="stat-num">12</span><span class="stat-label">data sources</span></div>
          <div class="stat"><span class="stat-num">8</span><span class="stat-label">profiles</span></div>
          <div class="stat"><span class="stat-num">3.5M+</span><span class="stat-label">records</span></div>
          <div class="stat"><span class="stat-num">1</span><span class="stat-label">endpoint</span></div>
        </div>
      </aside>
    </div>

    <div class="hero-tech">
      <a class="tech-tag" href="https://viaduct.dev/" target="_blank" rel="noopener">Viaduct</a>
      <span class="tech-tag">Kotlin/JVM</span>
      <span class="tech-tag">PostgreSQL + PostGIS</span>
      <span class="tech-tag">MapLibre</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .topo-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
  }

  .hero-badge {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 6px 14px;
    border: 1px solid var(--accent-dim);
    border-radius: 4px;
    background: var(--accent-dim);
    text-decoration: none;
    transition: background 0.2s;
  }

  .hero-badge:hover {
    background: rgba(232, 197, 71, 0.22);
    opacity: 1;
  }

  .hero-sub a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
    max-width: 800px;
  }

  .accent {
    color: var(--accent);
  }

  .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 1fr);
    gap: 64px;
    align-items: start;
    margin-bottom: 48px;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .hero-right-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 560px;
    line-height: 1.65;
    margin-bottom: 0;
  }

  .hero-grounding {
    font-size: 0.98rem;
    color: var(--text);
    line-height: 1.5;
    font-weight: 500;
    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }

  .hero-tail {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    margin-top: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--border);
  }

  .hero-tech {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tech-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--text-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .hero-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-right {
      border-top: 1px solid var(--border);
      padding-top: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 80px 0 60px;
    }

    .stat-divider {
      display: none;
    }
  }
</style>
