---
const moments = [
  {
    num: '01',
    title: 'One block, five systems',
    location: '16th & Mission',
    punchline: 'Five data sources. One query. No client joins.',
    description: 'Resolve permits, zoning, transit, 311, and census in one query.',
  },
  {
    num: '02',
    title: 'Same query, different output',
    location: '16th & Mission',
    punchline: '',
    description: 'Planner sees zoning compliance. Resident sees walkability. Developer sees disruption risk.',
  },
  {
    num: '03',
    title: 'The invisible city',
    location: 'Outer Sunset',
    punchline: '',
    description: 'Canopy coverage, green space access, commute patterns.',
  },
];
---

<section id="demo">
  <div class="demo-wrap">
    <header class="demo-heading">
      <span class="demo-marker mono">// demo</span>
      <h2 class="demo-title">
        These are compositions<br />
        of the same graph.
      </h2>
    </header>

    <ol class="moments">
      {moments.map((m) => (
        <li class="moment">
          <div class="moment-head">
            <span class="moment-num mono">{m.num}</span>
            <span class="moment-location mono">{m.location}</span>
          </div>
          <h3 class="moment-title">{m.title}</h3>
          <p class="moment-desc">{m.description}</p>
          {m.punchline ? (
            <p class="moment-punchline">&ldquo;{m.punchline}&rdquo;</p>
          ) : null}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  #demo {
    padding: 120px 0;
  }

  .demo-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .demo-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 64px;
    max-width: 640px;
  }

  .demo-marker {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .demo-title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .moments {
    list-style: none;
    list-style-type: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .moment {
    list-style: none;
    padding: 56px 0;
    border-bottom: 1px solid var(--border);
  }

  .moment-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 28px;
  }

  .moment-num {
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .moment-location {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .moment-title {
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 18px;
    max-width: 680px;
  }

  .moment-desc {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 640px;
  }

  .moment-punchline {
    font-size: 0.98rem;
    color: var(--accent);
    font-style: italic;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    line-height: 1.6;
    margin-top: 24px;
    max-width: 640px;
  }

  @media (max-width: 640px) {
    #demo {
      padding: 80px 0;
    }

    .demo-heading {
      margin-bottom: 48px;
    }

    .moment {
      padding: 40px 0;
    }

    .moment-head {
      margin-bottom: 22px;
    }

    .moment-num {
      font-size: 1.75rem;
    }

    .moment-desc {
      line-height: 1.7;
    }
  }
</style>
